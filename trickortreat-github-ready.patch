diff --git a/tests/test_plugin.py b/tests/test_plugin.py
new file mode 100644
index 0000000..f6510fb
--- /dev/null
+++ b/tests/test_plugin.py
@@ -0,0 +1,38 @@
+import sys, unittest, tempfile, os
+from pathlib import Path
+from unittest.mock import patch, Mock
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'daemon'))
+import fpp_client, fpp_provision, halloween_art, image_processor
+from PIL import Image
+
+class PluginTests(unittest.TestCase):
+ def test_uploaded_art_preserved(self):
+  for costume in halloween_art.COSTUMES:
+   with Image.open(ROOT/'static'/'silhouettes'/f'{costume}.png') as im:
+    self.assertEqual(im.size,(192,140))
+    self.assertEqual(image_processor.prepare_display_image(None,costume,'Alex',192,140).size,(192,140))
+ def test_render_badges(self):
+  c=fpp_client.FPPClient('http://localhost','TickerZone','spooky_news')
+  photo=Image.new('RGBA',(192,140),'black')
+  with patch.object(fpp_client.requests,'post',return_value=Mock(status_code=200)) as call:
+   for verdict in ['trick','treat']:
+    self.assertTrue(c.push_photo_overlay(photo,'<B>MAX</B>',verdict))
+    from io import BytesIO
+    with Image.open(BytesIO(call.call_args.kwargs['data'])) as rendered:
+     self.assertEqual(rendered.size,(192,140))
+   self.assertTrue(c.push_ticker_text('<B>MAX</B>','trick'))
+   args=call.call_args.kwargs['json']['args']
+   self.assertNotIn('<',args[-1]); self.assertIn('MAX',args[-1]); self.assertEqual(args[3],'#6EE628')
+ def test_model_response_fail_closed(self):
+  with patch.object(fpp_provision.requests,'get',return_value=Mock(json=lambda:{'garbage':[]},raise_for_status=lambda:None)):
+   with self.assertRaises(fpp_provision.ProvisionError): fpp_provision.get_models('http://localhost')
+ def test_model_preserves_source_models(self):
+  preserved={'Name':'RealMatrix','Type':'Channel','StartChannel':1,'ChannelCount':110592,'StringCount':192,'ChannelCountPerNode':3}
+  with patch.object(fpp_provision.requests,'post',return_value=Mock(raise_for_status=lambda:None)) as call:
+   fpp_provision.save_models('http://localhost',[preserved,{'Name':'PhotoZone'}],True)
+   self.assertEqual(call.call_args.kwargs['json']['models'][0],preserved)
+ def test_next_channel(self):
+  self.assertEqual(fpp_provision._next_start_channel([{'StartChannel':1,'ChannelCount':30}]),31)
+
+if __name__=='__main__': unittest.main()
diff --git a/tools/make_silhouettes.py b/tools/make_silhouettes.py
new file mode 100755
index 0000000..27a164c
--- /dev/null
+++ b/tools/make_silhouettes.py
@@ -0,0 +1,12 @@
+#!/usr/bin/env python3
+"""Writes the built-in costume scenes to static/silhouettes/*.png (192x140).
+Edit or replace any PNG there to customize the no-photo fallback art."""
+import os, sys
