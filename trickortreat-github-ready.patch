+"""
+Image processing for the photo zone. Same fit/fallback logic as the
+NaughtyNice plugin, but the no-photo fallback is a Halloween costume scene
+(ghost / pumpkin / witch / bat / skull / cat) instead of a boy/girl
+silhouette.
+"""
+
+import io
+import logging
+import os
+from typing import Optional
+
+from PIL import Image, ImageOps
+
+from halloween_art import draw_costume, pick_costume
+
+log = logging.getLogger(__name__)
+
+SILHOUETTE_DIR = os.path.join(os.path.dirname(__file__), "..", "static", "silhouettes")
+
+
+def prepare_display_image(photo_bytes: Optional[bytes], costume: Optional[str], name: str,
+                          target_w: int, target_h: int) -> Image.Image:
+    """Return a PIL Image (RGBA, target_w x target_h) for the photo zone.
+
+    If photo_bytes decodes to a valid image, use it; otherwise fall back to
+    costume art. `costume` is free text (or the cloud's legacy 'gender')."""
+    img: Optional[Image.Image] = None
+
+    if photo_bytes:
+        try:
+            img = Image.open(io.BytesIO(photo_bytes))
+            img.load()
+            img = ImageOps.exif_transpose(img)  # phone photos arrive rotated otherwise
+        except Exception as exc:
+            log.warning("Could not decode photo (%s), falling back to costume art", exc)
+            img = None
+
+    if img is None:
+        img = _load_costume_art(pick_costume(costume, name), target_w, target_h)
+
+    return _fit_to_zone(img, target_w, target_h)
+
+
+def _load_costume_art(costume: str, w: int, h: int) -> Image.Image:
+    path = os.path.join(SILHOUETTE_DIR, f"{costume}.png")
+    if os.path.exists(path):
+        try:
+            return Image.open(path)
+        except Exception as exc:
+            log.error("Failed to load costume art %s: %s — drawing default", path, exc)
+    return draw_costume(costume, w, h)
+
+
+def _fit_to_zone(img: Image.Image, target_w: int, target_h: int) -> Image.Image:
+    img = img.convert("RGBA")
+    return ImageOps.fit(img, (target_w, target_h), method=Image.LANCZOS)
