+#!/usr/bin/env python3
+"""
+Trick-or-Treat News plugin daemon.
+
+Runs on the FPP box itself. Two sources of submissions:
+
+1. The LOCAL queue (config/local_queue.json) — filled by the plugin's own
+   "Door" page (door.php, a phone-friendly form for whoever is handing out
+   candy) and by the "Test fire" button on the setup page. Works with no
+   internet and no cloud account at all.
+2. An optional CLOUD service speaking the same outbound-only /api/v1
+   protocol as the NaughtyNice Cloud plugin this was forked from. Only
+   polled once a cloud URL + token are saved on the setup page.
+
+Every exception inside the loop is caught, logged, and turned into a
+retry/nack or a backoff rather than a crash, so a bad item or a network
+blip never takes the daemon (or fppd) down.
+
+Launched by scripts/postStart.sh, stopped by scripts/postStop.sh (SIGTERM).
+"""
+
+import logging
+import shutil
+import os
+import signal
+import sys
+import time
+from datetime import datetime, timezone
+
+from cloud_client import CloudApiError, CloudClient, InvalidToken, LicenseExpired
+from config import (finish_local_item, load_settings, local_photo_path, local_queue_length,
+                    peek_local_queue, read_status, write_status)
+from fpp_client import FPPClient, normalize_verdict
+from image_processor import prepare_display_image
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s %(levelname)s [tot_daemon] %(message)s",
+    stream=sys.stdout,
+)
+log = logging.getLogger("tot_daemon")
+
+PLUGIN_VERSION = "1.0.0"
+MAX_BACKOFF_SECONDS = 300
+HEARTBEAT_SECONDS = 30
+# tot_display_image.py sleeps this long before reading the uploaded image;
+# must match UPLOAD_SETTLE_SECONDS there.
+DISPLAY_SETTLE_SECONDS = 3
+
+_stop = False
+
+
+def _handle_sigterm(signum, frame):
+    global _stop
+    log.info("Received signal %s, shutting down after current cycle", signum)
+    _stop = True
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _interruptible_sleep(seconds: float) -> None:
+    end = time.monotonic() + seconds
+    while not _stop and time.monotonic() < end:
+        time.sleep(max(0.0, min(1.0, end - time.monotonic())))
+
+
+def _ffmpeg_works() -> bool:
+    import subprocess
+    try:
+        return subprocess.run(["ffmpeg", "-version"], stdout=subprocess.DEVNULL,
+                              stderr=subprocess.DEVNULL, timeout=5).returncode == 0
+    except (OSError, subprocess.TimeoutExpired):
+        return False
+
+
+def _deliver(fpp: FPPClient, settings, name: str, verdict: str, costume, photo_bytes, show_photo: bool) -> bool:
+    """Render one submission. Returns True only if every FPP call succeeded."""
+    if show_photo and not (shutil.which("ffmpeg") and _ffmpeg_works()):
+        log.warning("FFmpeg unavailable; using ticker-only display for this submission")
+        show_photo = False
+    if not show_photo:
+        # Do not start the image playlist here: it would replay a stale photo.
+        return fpp.push_ticker_text(name, verdict, costume)
+
+    display_img = prepare_display_image(photo_bytes, costume, name,
+                                        settings.matrix_width, settings.photo_zone_height)
+    ok = fpp.push_photo_overlay(display_img, name, verdict, settings.header_text)
+    ok = ok and fpp.break_in_and_sync()
+    return ok and fpp.push_ticker_text(name, verdict, costume)
+
+
+def _hold_for_display(settings) -> None:
+    """Each delivery breaks into the playlist, so delivering the next item
+    immediately would cut the current one off mid-display. Wait for the
+    script entry's settle + hold time before moving on."""
+    _interruptible_sleep(settings.display_duration_seconds + DISPLAY_SETTLE_SECONDS + 1)
+
+
+def _process_local_item(fpp: FPPClient, settings, item: dict) -> bool:
+    item_id = item.get("id", "?")
+    name = str(item.get("child_name", "")).strip()[:40]
+    verdict = normalize_verdict(item.get("verdict"))
+    costume = str(item.get("costume") or "").strip()[:40] or None
+    ok = False
+    try:
+        photo_bytes = None
+        path = local_photo_path(item)
+        if path:
+            with open(path, "rb") as f:
+                photo_bytes = f.read()
+        ok = _deliver(fpp, settings, name, verdict, costume, photo_bytes, settings.local_show_photo)
+        if ok:
+            log.info("Delivered local item %s (%s, %s)", item_id, name, verdict)
+        else:
+            log.warning("Local item %s failed (FPP call failure) — will retry", item_id)
+    except Exception:  # noqa: BLE001 — one bad item must never kill the loop
+        log.exception("Unhandled error processing local item %s", item_id)
+    finally:
+        try:
+            finish_local_item(item_id, ok)
+        except Exception:
+            log.exception("Could not update local queue for item %s", item_id)
+    return ok
+
+
+def _process_cloud_item(cloud: CloudClient, fpp: FPPClient, settings, item: dict, plan: str) -> bool:
+    submission_id = item["id"]
+    name = item.get("child_name", "")
+    verdict = normalize_verdict(item.get("verdict"))
+    # A Halloween-aware service can send "costume"; the original protocol
+    # sends "gender", which pick_costume() turns into a stable random scene.
+    costume = item.get("costume") or item.get("gender")
+    try:
+        photo_bytes = None
+        if plan != "text_only" and item.get("photo_url"):
+            try:
+                photo_bytes = cloud.fetch_photo(item["photo_url"])
+            except CloudApiError as exc:
+                log.warning("Photo download failed (%s) — using costume art", exc)
+
+        ok = _deliver(fpp, settings, name, verdict, costume, photo_bytes, plan != "text_only")
+
+        if ok:
+            cloud.ack(submission_id)
+            log.info("Delivered cloud submission %s (%s, %s)", submission_id, name, verdict)
+        else:
+            cloud.nack(submission_id, "one or more FPP calls failed — see plugin log")
+            log.warning("Nacked submission %s after FPP call failure", submission_id)
+        return ok
+    except Exception as exc:  # noqa: BLE001
+        log.exception("Unhandled error processing submission %s", submission_id)
+        try:
+            cloud.nack(submission_id, f"exception: {exc}")
+        except Exception:
+            log.exception("Also failed to nack submission %s after the original error", submission_id)
+        return False
+
+
+def _make_fpp(settings) -> FPPClient:
+    return FPPClient(
+        settings.fpp_base_url, settings.ticker_model, settings.playlist,
+        matrix_width=settings.matrix_width, photo_zone_height=settings.photo_zone_height,
+    )
+
+
+def _cloud_cycle(settings, fpp: FPPClient, state: dict) -> None:
+    """One poll of the optional cloud service. Updates state['backoff'] and
+    state['next_cloud'] (monotonic time of the next allowed poll)."""
+    cloud = CloudClient(settings.cloud_base_url, settings.token)
+    interval = max(settings.poll_interval_seconds, 5)
+
+    def backoff(**status):
+        state["backoff"] = min(state["backoff"] * 2, MAX_BACKOFF_SECONDS)
+        state["next_cloud"] = time.monotonic() + state["backoff"]
+        write_status(last_poll_at=_now_iso(), **status)
+
+    try:
+        ping = cloud.ping()
+    except InvalidToken:
+        return backoff(license="invalid_token", last_error="Cloud rejected the token — regenerate it in the dashboard")
+    except CloudApiError as exc:
+        log.warning("cloud ping failed: %s", exc)
+        return backoff(last_error=str(exc))
+
+    state["backoff"] = 1
+    state["next_cloud"] = time.monotonic() + interval
+    license_state = ping.get("license", "unknown")
+    license_expires = ping.get("expires")
+
+    if license_state != "active":
+        write_status(license=license_state, license_expires=license_expires, last_poll_at=_now_iso(), last_error=None)
+        return
+
+    try:
+        queue = cloud.get_queue()
+    except LicenseExpired:
+        write_status(license="expired", last_poll_at=_now_iso())
+        return
+    except (CloudApiError, InvalidToken) as exc:
+        log.warning("queue fetch failed: %s", exc)
+        write_status(last_error=str(exc), last_poll_at=_now_iso())
+        return
+
+    plan = queue.get("show", {}).get("plan", "full")
+    for item in queue.get("items", []):
+        if _stop:
+            break
+        ok = _process_cloud_item(cloud, fpp, settings, item, plan)
+        if ok:
+            state["total"] += 1
+            _record_last(item.get("child_name", ""), item.get("verdict"), "cloud", state["total"])
+            _hold_for_display(settings)
+
+    fpp_version = fpp.get_fpp_version()
+    cloud.telemetry(PLUGIN_VERSION, fpp_version=fpp_version)
+    write_status(license="active", license_expires=license_expires, plan=plan,
+                 last_poll_at=_now_iso(), last_error=None, fpp_version=fpp_version)
+
+
+def _record_last(name, verdict, source, total) -> None:
+    write_status(items_processed_total=total,
+                 last_item={"name": name, "verdict": normalize_verdict(verdict), "source": source, "at": _now_iso()})
+
+
+def run() -> None:
+    log.info("Starting Trick-or-Treat News plugin daemon v%s", PLUGIN_VERSION)
+
+    state = {
+        "total": read_status().get("items_processed_total", 0),
+        "backoff": 1,
+        "next_cloud": 0.0,
+    }
+    last_heartbeat = 0.0
+    write_status(plugin_version=PLUGIN_VERSION, daemon_started_at=_now_iso(), daemon_pid=os.getpid())
+
+    while not _stop:
+        settings = load_settings()
+
+        if not settings.enabled:
+            write_status(license="disabled", last_poll_at=_now_iso())
+            _interruptible_sleep(max(settings.poll_interval_seconds, 5))
+            continue
+
+        fpp = _make_fpp(settings)
+
+        # 1. Local queue first — someone is standing at the door waiting.
+        try:
+            item = peek_local_queue()
+        except Exception:
+            log.exception("Could not read local queue")
+            item = None
+
+        if item:
+            ok = _process_local_item(fpp, settings, item)
+            if ok:
+                state["total"] += 1
+                _record_last(item.get("child_name", ""), item.get("verdict"), "local", state["total"])
+                _hold_for_display(settings)
+            else:
+                _interruptible_sleep(3)
+            continue
+
+        # 2. Optional cloud service, on its own (slower) interval.
+        if settings.cloud_configured:
+            if time.monotonic() >= state["next_cloud"]:
+                try:
+                    _cloud_cycle(settings, fpp, state)
+                except Exception:  # noqa: BLE001
+                    log.exception("Unexpected error during cloud cycle")
+                    state["next_cloud"] = time.monotonic() + max(settings.poll_interval_seconds, 5)
+
+        # 3. Heartbeat for the status pages (throttled — avoid SD-card churn).
+        now = time.monotonic()
+        if now - last_heartbeat >= HEARTBEAT_SECONDS:
+            last_heartbeat = now
+            extra = {} if settings.cloud_configured else {"license": "local_only"}
+            write_status(last_heartbeat_at=_now_iso(), local_queue_length=local_queue_length(),
+                         plugin_version=PLUGIN_VERSION, fpp_version=fpp.get_fpp_version(), **extra)
+
+        _interruptible_sleep(max(1, int(settings.local_poll_seconds)))
+
+    log.info("Daemon stopped cleanly")
+
+
+if __name__ == "__main__":
+    signal.signal(signal.SIGTERM, _handle_sigterm)
+    signal.signal(signal.SIGINT, _handle_sigterm)
+    run()
