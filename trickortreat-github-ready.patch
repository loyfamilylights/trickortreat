new file mode 100755
index 0000000..b42aa38
--- /dev/null
+++ b/scripts/_lib.sh
@@ -0,0 +1,58 @@
+#!/bin/bash
+# Shared lifecycle helpers. FPP supplies LOGDIR/MEDIADIR through common.
+: "${FPPDIR:=/opt/fpp}"
+if [ -f "${FPPDIR}/scripts/common" ]; then
+    . "${FPPDIR}/scripts/common"
+fi
+: "${MEDIADIR:=/home/fpp/media}"
+: "${LOGDIR:=${MEDIADIR}/logs}"
+PLUGIN_DIR="${MEDIADIR}/plugins/fpp-plugin-trickortreat"
+PIDFILE="${PLUGIN_DIR}/tot_daemon.pid"
+LOGFILE="${LOGDIR}/plugin-fpp-plugin-trickortreat.log"
+
+tot_log() {
+    mkdir -p "$LOGDIR" 2>/dev/null || true
+    printf '%s [trickortreat] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOGFILE" 2>/dev/null || true
+}
+
+tot_pid_owned() {
+    local pid="$1" cmd cwd
+    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
+    [ -d "/proc/$pid" ] || return 1
+    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
+    [[ "$cmd" == *"tot_daemon.py"* ]] || return 1
+    cwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null) || return 1
+    [ "$cwd" = "${PLUGIN_DIR}/daemon" ] || return 1
+}
+
+tot_stop_if_running() {
+    local pid i
+    [ -f "$PIDFILE" ] || return 0
+    pid=$(cat "$PIDFILE" 2>/dev/null || true)
+    if tot_pid_owned "$pid"; then
+        kill -TERM "$pid" 2>/dev/null || true
+        # Bounded graceful shutdown. Never target unrelated processes.
+        for i in 1 2 3 4 5; do
+            tot_pid_owned "$pid" || break
+            sleep 1
+        done
+        if tot_pid_owned "$pid"; then
+            kill -KILL "$pid" 2>/dev/null || true
+        fi
+        tot_log "Stopped owned daemon PID $pid"
+    else
+        tot_log "Ignoring stale or foreign PID file"
+    fi
+    rm -f "$PIDFILE"
+}
+
+tot_python() {
+    local py="${PLUGIN_DIR}/venv/bin/python3"
+    [ -x "$py" ] || return 1
+    "$py" -c 'import requests; from PIL import Image' >/dev/null 2>&1 || return 1
+    printf '%s\n' "$py"
+}
+
+tot_ffmpeg_available() {
+    command -v ffmpeg >/dev/null 2>&1 && ffmpeg -version >/dev/null 2>&1
+}
diff --git a/scripts/fpp_install.sh b/scripts/fpp_install.sh
new file mode 100755
index 0000000..1647a50
--- /dev/null
+++ b/scripts/fpp_install.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+# Idempotent first install/reinstall; never overwrite saved configuration.
+set -Eeuo pipefail
+. "$(dirname "$0")/_lib.sh"
+fail() { tot_log "ERROR: $*"; echo "Trick-or-Treat: ERROR: $*" >&2; exit 1; }
+command -v python3 >/dev/null 2>&1 || fail "python3 missing; cannot install dependencies"
+command -v sha256sum >/dev/null 2>&1 || fail "sha256sum missing"
+[ -d "$PLUGIN_DIR" ] || fail "plugin directory missing: $PLUGIN_DIR"
+mkdir -p "${PLUGIN_DIR}/config/uploads" || fail "cannot create config directory"
+# Existing settings, queues, uploads, and overlay/playlist resources are never reset.
+if [ ! -x "${PLUGIN_DIR}/venv/bin/python3" ]; then
+    python3 -m venv "${PLUGIN_DIR}/venv" || fail "python3 -m venv failed; check python3-venv installation"
+fi
+PY="${PLUGIN_DIR}/venv/bin/python3"
+"$PY" -m pip --version >/dev/null 2>&1 || fail "venv pip unavailable"
+"$PY" -m pip install -r "${PLUGIN_DIR}/daemon/requirements.txt" || fail "pip dependency installation failed (check network, certificates, disk space, Python compatibility)"
+"$PY" -c 'import requests; from PIL import Image; print("Python dependencies OK")' || fail "required Python imports failed after installation"
+# Single shared script used by the playlist. Never overwrite unrelated scripts.
+SHARED="${MEDIADIR}/scripts/tot_display_image.py"
+OWNER="${PLUGIN_DIR}/config/shared-script.sha256"
+SOURCE="${PLUGIN_DIR}/scripts/tot_display_image.py"
+mkdir -p "${MEDIADIR}/scripts" || fail "cannot create FPP scripts directory"
+if [ -e "$SHARED" ]; then
+    if [ -f "$OWNER" ]; then
+        expected=$(cat "$OWNER")
+        actual=$(sha256sum "$SHARED" | cut -d' ' -f1)
+        [ "$expected" = "$actual" ] || fail "shared script has been modified; refusing to overwrite $SHARED"
+    elif ! cmp -s "$SOURCE" "$SHARED"; then
+        fail "shared script exists but is not owned by this installation: $SHARED"
+    fi
+fi
+install -m 755 "$SOURCE" "$SHARED" || fail "failed to deploy shared script"
+sha256sum "$SHARED" | cut -d' ' -f1 > "$OWNER" || fail "could not save script ownership marker"
+if id fpp >/dev/null 2>&1; then
+    chown -R fpp:fpp "${PLUGIN_DIR}/config" "${PLUGIN_DIR}/venv" || fail "could not make plugin state writable by fpp"
+    chown fpp:fpp "$SHARED" || fail "could not set shared-script owner"
+fi
+if tot_ffmpeg_available; then
+    tot_log "FFmpeg ready: photo display available"
+else
+    tot_log "WARNING: FFmpeg unavailable; photo display disabled until installed (ticker remains available)"
+    echo 'Trick-or-Treat: WARNING: FFmpeg unavailable; photo display disabled, ticker remains available.' >&2
+fi
+# Never auto-provision/change existing FPP overlay models or playlists.
+tot_log "Install complete; settings and user playlists/models untouched"
+echo 'Trick-or-Treat: installation complete; configure zones from the plugin setup page.'
diff --git a/scripts/fpp_uninstall.sh b/scripts/fpp_uninstall.sh
new file mode 100755
index 0000000..79215ff
--- /dev/null
+++ b/scripts/fpp_uninstall.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Never remove user-created playlists, overlay models or plugin settings.
+set -u
+. "$(dirname "$0")/_lib.sh"
+tot_stop_if_running
+SHARED="${MEDIADIR}/scripts/tot_display_image.py"
+OWNER="${PLUGIN_DIR}/config/shared-script.sha256"
+if [ -f "$OWNER" ] && [ -f "$SHARED" ]; then
+    expected=$(cat "$OWNER" 2>/dev/null || true)
+    actual=$(sha256sum "$SHARED" 2>/dev/null | cut -d' ' -f1)
+    if [ -n "$expected" ] && [ "$expected" = "$actual" ]; then
+        rm -f "$SHARED"
+        tot_log "Removed unchanged plugin-owned shared script"
+    else
+        tot_log "Shared script changed since install; leaving it intact"
+    fi
+fi
+tot_log "Uninstalled lifecycle resources; user playlists/models not touched"
+echo 'Trick-or-Treat: plugin runtime resources cleaned up'
