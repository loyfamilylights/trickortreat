new file mode 100755
index 0000000..dc028e4
--- /dev/null
+++ b/scripts/postStart.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+. "$(dirname "$0")/_lib.sh"
+if [ -f "$PIDFILE" ]; then
+    oldpid=$(cat "$PIDFILE" 2>/dev/null || true)
+    if tot_pid_owned "$oldpid"; then
+        tot_log "Daemon already running (PID $oldpid)"
+        exit 0
+    fi
+    rm -f "$PIDFILE"
+fi
+if ! PYTHON_BIN=$(tot_python); then
+    tot_log "ERROR: Python virtual environment or required packages unavailable; daemon not started"
+    exit 1
+fi
+mkdir -p "$LOGDIR" || exit 1
+cd "${PLUGIN_DIR}/daemon" || exit 1
+# STDERR/STDOUT to FPP's single managed plugin log.
+nohup "$PYTHON_BIN" tot_daemon.py >> "$LOGFILE" 2>&1 < /dev/null &
+pid=$!
+echo "$pid" > "$PIDFILE"
+# Verify child startup briefly without blocking FPP for long.
+sleep 1
+if ! tot_pid_owned "$pid"; then
+    rm -f "$PIDFILE"
+    tot_log "ERROR: daemon launch failed immediately"
+    exit 1
+fi
+tot_log "Started daemon (PID $pid)"
