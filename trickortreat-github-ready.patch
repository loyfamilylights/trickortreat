diff --git a/lib/config.php b/lib/config.php
new file mode 100644
index 0000000..a1e1285
--- /dev/null
+++ b/lib/config.php
@@ -0,0 +1,330 @@
+<?php
+// Shared settings/status/local-queue helpers for this plugin's PHP pages.
+// Mirrors daemon/config.py exactly (same file paths, same JSON shape) so
+// the PHP UI and the Python daemon can both read/write without stepping
+// on each other. Deliberately NOT using FPP's native plugin.<name> ini
+// settings file — plain JSON is simple, atomic (write-then-rename), and
+// equally readable from both languages.
+
+define('TOT_PLUGIN_NAME', 'fpp-plugin-trickortreat');
+define('TOT_PLUGIN_DIR', dirname(__DIR__));
+define('TOT_CONFIG_DIR', TOT_PLUGIN_DIR . '/config');
+define('TOT_SETTINGS_PATH', TOT_CONFIG_DIR . '/settings.json');
+define('TOT_STATUS_PATH', TOT_CONFIG_DIR . '/status.json');
+define('TOT_QUEUE_PATH', TOT_CONFIG_DIR . '/local_queue.json');
+define('TOT_QUEUE_LOCK', TOT_CONFIG_DIR . '/local_queue.lock');
+define('TOT_UPLOADS_DIR', TOT_CONFIG_DIR . '/uploads');
+define('TOT_QUEUE_MAX', 25);           // keeps a spammy door page from backing up the show all night
+define('TOT_PHOTO_MAX_BYTES', 2000000);
+
+// Optional cloud service — two credential slots (same protocol as the
+// NaughtyNice Cloud plugin). Both blank by default: local-only works fine.
+// Must stay in sync with ENVIRONMENTS/ENVIRONMENT_DEFAULTS in daemon/config.py.
+define('TOT_ENVIRONMENT_NAMES', array('prod', 'dev'));
+
+function tot_default_environments() {
+    return array(
+        'prod' => array('cloud_base_url' => '', 'token' => ''),
+        'dev' => array('cloud_base_url' => '', 'token' => ''),
+    );
+}
+
+function tot_default_settings() {
+    return array(
+        'environment' => 'prod',
+        'environments' => tot_default_environments(),
+        'fpp_base_url' => 'http://localhost',
+        'poll_interval_seconds' => 10,
+        'local_poll_seconds' => 2,
+        'playlist' => 'spooky_news',
+        'ticker_model' => 'TickerZone',
+        'photo_model' => 'PhotoZone',
+        'matrix_width' => 192,
+        'matrix_height' => 192,
+        'photo_zone_height' => 140,
+        'ticker_zone_height' => 52,
+        'display_duration_seconds' => 20,
+        'local_show_photo' => true,
+        'header_text' => 'SPOOKY NEWS',
+        'cloud_enabled' => true,
+        'enabled' => true,
+    );
+}
+
+function tot_load_settings() {
+    $settings = tot_default_settings();
+    if (!file_exists(TOT_SETTINGS_PATH)) {
+        return $settings;
+    }
+    $raw = json_decode(file_get_contents(TOT_SETTINGS_PATH), true);
+    if (!is_array($raw)) {
+        return $settings;
+    }
+    foreach (array_keys($settings) as $key) {
+        if ($key !== 'environments' && isset($raw[$key])) {
+            $settings[$key] = $raw[$key];
+        }
+    }
+    if (isset($raw['environments']) && is_array($raw['environments'])) {
+        foreach (TOT_ENVIRONMENT_NAMES as $envName) {
+            if (isset($raw['environments'][$envName]) && is_array($raw['environments'][$envName])) {
+                $settings['environments'][$envName] = array_merge(
+                    $settings['environments'][$envName],
+                    array_intersect_key($raw['environments'][$envName], $settings['environments'][$envName])
+                );
+            }
+        }
+    }
+    if (!in_array($settings['environment'], TOT_ENVIRONMENT_NAMES, true)) {
+        $settings['environment'] = 'prod';
+    }
+    return $settings;
+}
+
+function tot_config_dir_problem() {
+    if (!is_dir(TOT_CONFIG_DIR)) {
+        if (!@mkdir(TOT_CONFIG_DIR, 0755, true) && !is_dir(TOT_CONFIG_DIR)) {
+            return "Could not create config directory (" . TOT_CONFIG_DIR . "). Check permissions.";
+        }
+    }
+    if (!is_writable(TOT_CONFIG_DIR)) {
+        return "Config directory (" . TOT_CONFIG_DIR . ") is not writable by the web server user. " .
+            "A plugin script probably ran as root and left it root-owned -- run: sudo chown -R fpp:fpp " . TOT_CONFIG_DIR;
+    }
+    return null;
+}
+
+// Returns array('ok' => bool, 'message' => string|null). Callers MUST check 'ok'.
+function tot_save_settings($settings) {
+    $problem = tot_config_dir_problem();
+    if ($problem) {
+        return array('ok' => false, 'message' => $problem);
+    }
+    $tmp = TOT_SETTINGS_PATH . '.tmp';
+    if (@file_put_contents($tmp, json_encode($settings, JSON_PRETTY_PRINT)) === false) {
+        return array('ok' => false, 'message' => "Failed to write settings to $tmp. Check disk space and permissions.");
+    }
+    if (!@rename($tmp, TOT_SETTINGS_PATH)) {
+        return array('ok' => false, 'message' => "Failed to move settings into place at " . TOT_SETTINGS_PATH . ".");
+    }
+    return array('ok' => true, 'message' => null);
+}
+
+function tot_read_status() {
+    if (file_exists(TOT_STATUS_PATH)) {
+        $raw = json_decode(file_get_contents(TOT_STATUS_PATH), true);
+        if (is_array($raw)) {
+            return $raw;
+        }
+    }
+    return array();
+}
+
+function tot_active_env($settings) {
+    $envName = isset($settings['environment']) ? $settings['environment'] : 'prod';
+    if (!in_array($envName, TOT_ENVIRONMENT_NAMES, true)) {
+        $envName = 'prod';
+    }
+    $env = isset($settings['environments'][$envName]) ? $settings['environments'][$envName] : array();
+    return array(
+        'name' => $envName,
+        'cloud_base_url' => isset($env['cloud_base_url']) ? $env['cloud_base_url'] : '',
+        'token' => isset($env['token']) ? $env['token'] : '',
+    );
+}
+
+function tot_cloud_configured($settings) {
+    $a = tot_active_env($settings);
+    return !empty($settings['cloud_enabled']) && $a['token'] !== '' && $a['cloud_base_url'] !== '';
+}
+
+// Is the daemon process actually alive? (PID file written by postStart.sh)
+function tot_daemon_running() {
+    $pidFile = TOT_PLUGIN_DIR . '/tot_daemon.pid';
+    if (!file_exists($pidFile)) {
+        return false;
+    }
+    $pid = intval(trim(@file_get_contents($pidFile)));
+    if ($pid <= 0 || !file_exists("/proc/$pid/cmdline")) return false;
+    $cmdline = @file_get_contents("/proc/$pid/cmdline");
+    return $cmdline !== false && strpos($cmdline, 'tot_daemon.py') !== false;
+}
+
+// --- Local queue ---------------------------------------------------------
+// Same flock()-protected JSON list the daemon consumes (daemon/config.py).
+
+function tot_with_queue_lock($fn) {
+    $problem = tot_config_dir_problem();
+    if ($problem) {
+        return array('ok' => false, 'message' => $problem);
+    }
+    $fh = @fopen(TOT_QUEUE_LOCK, 'c');
+    if (!$fh) {
+        return array('ok' => false, 'message' => 'Could not open queue lock file.');
+    }
+    flock($fh, LOCK_EX);
+    $items = array();
+    if (file_exists(TOT_QUEUE_PATH)) {
+        $decoded = json_decode(file_get_contents(TOT_QUEUE_PATH), true);
+        if (is_array($decoded)) {
+            $items = $decoded;
+        }
+    }
+    $result = $fn($items);   // returns array(resultForCaller, newItemsToWrite or null for read-only)
+    if ($result[1] !== null) {
+        $tmp = TOT_QUEUE_PATH . '.tmp';
+        if (@file_put_contents($tmp, json_encode(array_values($result[1]), JSON_PRETTY_PRINT)) === false || !@rename($tmp, TOT_QUEUE_PATH)) {
+            @unlink($tmp);
+            $result[0] = array('ok' => false, 'message' => 'Could not save the queue; check FPP disk space and permissions.');
+        }
+    }
+    flock($fh, LOCK_UN);
+    fclose($fh);
+    return $result[0];
+}
+
+function tot_read_queue() {
+    $r = tot_with_queue_lock(function ($items) { return array(array('ok' => true, 'items' => $items), null); });
+    return isset($r['items']) ? $r['items'] : array();
+}
+
+// $photoDataUrl: optional "data:image/jpeg;base64,..." (the door page
+// downsizes the phone photo in the browser first, so it's small).
+function tot_enqueue_local($name, $verdict, $costume, $photoDataUrl = '') {
+    $name = trim(preg_replace('/[\p{C}<>]+/u', '', strip_tags(preg_replace('/\s+/u', ' ', (string)$name))));
+    $costume = trim(preg_replace('/[\p{C}<>]+/u', '', strip_tags(preg_replace('/\s+/u', ' ', (string)$costume))));
+    $verdict = strtolower(trim((string)$verdict));
+
+    if ($name === '') {
+        return array('ok' => false, 'message' => 'Type a name first.');
+    }
+    if (function_exists('mb_substr')) {
+        $name = mb_substr($name, 0, 40);
+        $costume = mb_substr($costume, 0, 40);
+    } else {
+        $name = substr($name, 0, 40);
+        $costume = substr($costume, 0, 40);
+    }
+    if (!in_array($verdict, array('treat', 'trick'), true)) {
+        return array('ok' => false, 'message' => 'Choose TREAT or TRICK.');
+    }
+
+    $id = 'local-' . date('YmdHis') . '-' . bin2hex(random_bytes(3));
+    $photoFile = null;
+
+    if ($photoDataUrl !== '' && preg_match('#^data:image/(jpeg|png);base64,(.+)$#s', $photoDataUrl, $m)) {
+        $bytes = base64_decode($m[2], true);
+        if ($bytes !== false && strlen($bytes) <= TOT_PHOTO_MAX_BYTES && @getimagesizefromstring($bytes) !== false) {
+            if (!is_dir(TOT_UPLOADS_DIR)) {
+                @mkdir(TOT_UPLOADS_DIR, 0755, true);
+            }
+            $photoFile = $id . ($m[1] === 'png' ? '.png' : '.jpg');
+            if (@file_put_contents(TOT_UPLOADS_DIR . '/' . $photoFile, $bytes) === false) {
+                $photoFile = null; // fall back to costume art rather than failing the whole entry
+            }
+        }
+    }
+
+    $entry = array(
+        'id' => $id,
+        'child_name' => $name,
+        'verdict' => $verdict,
+        'costume' => $costume,
+        'photo_file' => $photoFile,
+        'attempts' => 0,
+        'queued_at' => date('c'),
+    );
+
+    $result = tot_with_queue_lock(function ($items) use ($entry, $photoFile) {
+        if (count($items) >= TOT_QUEUE_MAX) {
+            if ($photoFile) {
+                @unlink(TOT_UPLOADS_DIR . '/' . $photoFile);
+            }
+            return array(array('ok' => false, 'message' => 'The line is full (' . TOT_QUEUE_MAX . ' waiting) — try again in a minute.'), null);
+        }
+        $items[] = $entry;
+        return array(array('ok' => true, 'position' => count($items), 'message' => 'Queued'), $items);
+    });
+    if (empty($result['ok']) && $photoFile) @unlink(TOT_UPLOADS_DIR . '/' . $photoFile);
+    return $result;
+}
+
+function tot_clear_queue() {
+    return tot_with_queue_lock(function ($items) {
+        foreach ($items as $it) {
+            if (!empty($it['photo_file'])) {
+                @unlink(TOT_UPLOADS_DIR . '/' . basename($it['photo_file']));
+            }
+        }
+        return array(array('ok' => true, 'message' => 'Cleared ' . count($items) . ' waiting item(s).'), array());
+    });
+}
+
+// Quick outbound test of the cloud API using the active environment's token.
+function tot_test_connection($settings) {
+    $active = tot_active_env($settings);
+    if (empty($active['token']) || empty($active['cloud_base_url'])) {
+        return array('ok' => false, 'message' => "No cloud service set for '{$active['name']}' — that's fine for a local-only show.");
+    }
+    $url = rtrim($active['cloud_base_url'], '/') . '/api/v1/ping';
+    $ch = curl_init($url);
+    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
+    curl_setopt($ch, CURLOPT_HTTPHEADER, array('Authorization: Bearer ' . $active['token']));
+    curl_setopt($ch, CURLOPT_TIMEOUT, 10);
+    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
+    $body = curl_exec($ch);
+    $err = curl_error($ch);
+    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
+    curl_close($ch);
+
+    $envLabel = strtoupper($active['name']);
+    if ($body === false) {
+        return array('ok' => false, 'message' => "[$envLabel] Connection failed: $err");
+    }
+    if ($code === 401) {
+        return array('ok' => false, 'message' => "[$envLabel] Cloud rejected the token (401) — check it was copied correctly.");
+    }
+    if ($code !== 200) {
+        return array('ok' => false, 'message' => "[$envLabel] Cloud returned HTTP $code: " . substr($body, 0, 200));
+    }
+    $data = json_decode($body, true);
+    $license = isset($data['license']) ? $data['license'] : 'unknown';
+    return array('ok' => true, 'message' => "[$envLabel] Connected to {$active['cloud_base_url']}. License status: $license");
+}
+
+// Hits FPP's own system-control endpoints. Deliberately NOT passing quick=1
+// on restart: a "quick" FPPD restart only reloads fppd's config in place and
+// does NOT re-run plugin preStart.sh/postStart.sh, so an already-running
+// daemon never gets replaced (found the hard way in the NaughtyNice plugin).
+// For reboot, a curl timeout/connection-reset is treated as success.
+function tot_fpp_system_action($settings, $path, $timeoutSeconds = 5) {
+    $url = rtrim($settings['fpp_base_url'], '/') . $path;
+    $ch = curl_init($url);
+    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
+    curl_setopt($ch, CURLOPT_TIMEOUT, $timeoutSeconds);
+    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, $timeoutSeconds);
+    $body = curl_exec($ch);
+    $err = curl_error($ch);
+    $errno = curl_errno($ch);
+    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
+    curl_close($ch);
+
+    if ($body === false && in_array($errno, array(28, 52, 56), true)) {
+        return array('ok' => true, 'message' => "Request sent to $path — FPP is restarting/rebooting now, give it a minute.");
+    }
+    if ($body === false) {
+        return array('ok' => false, 'message' => "Request to $path failed: $err");
+    }
+    if ($code !== 200) {
+        return array('ok' => false, 'message' => "$path returned HTTP $code: " . substr($body, 0, 200));
+    }
+    return array('ok' => true, 'message' => "Request sent to $path successfully.");
+}
+
+function tot_door_url() {
+    return 'plugin.php?plugin=' . TOT_PLUGIN_NAME . '&page=door.php&nopage=1';
+}
+
+function tot_h($v) {
+    return htmlspecialchars((string)$v, ENT_QUOTES);
+}
