diff --git a/daemon/cloud_client.py b/daemon/cloud_client.py
new file mode 100644
index 0000000..4cfb946
--- /dev/null
+++ b/daemon/cloud_client.py
@@ -0,0 +1,90 @@
+"""Client for an OPTIONAL cloud submissions service speaking the same
+/api/v1/* protocol as NaughtyNice Cloud (the service the original plugin
+was built for). Outbound-only: every call here is the plugin reaching out
+to the cloud service, never the reverse. Not needed at all for local-only
+shows — the daemon only creates a CloudClient once a URL + token are set."""
+
+import logging
+
+import requests
+
+log = logging.getLogger(__name__)
+
+
+class CloudApiError(Exception):
+    """Raised for network failures or unexpected (non-4xx-handled) responses."""
+
+
+class LicenseExpired(Exception):
+    """Raised when the cloud reports 402 — show's license has lapsed."""
+
+
+class InvalidToken(Exception):
+    """Raised when the cloud reports 401 — token is missing/wrong/revoked."""
+
+
+class CloudClient:
+    def __init__(self, base_url: str, token: str, timeout: int = 10):
+        self.base_url = base_url.rstrip("/")
+        self.token = token
+        self.timeout = timeout
+        self._session = requests.Session()
+        self._session.headers["Authorization"] = f"Bearer {token}"
+
+    def _request(self, method: str, path: str, **kwargs):
+        url = f"{self.base_url}{path}"
+        try:
+            r = self._session.request(method, url, timeout=self.timeout, **kwargs)
+        except requests.RequestException as exc:
+            raise CloudApiError(f"{method} {path} failed: {exc}") from exc
+
+        if r.status_code == 401:
+            raise InvalidToken("Cloud rejected the plugin token (401)")
+        if r.status_code == 402:
+            raise LicenseExpired("Show license has expired (402)")
+        if r.status_code >= 400:
+            raise CloudApiError(f"{method} {path} -> HTTP {r.status_code}: {r.text[:200]}")
+        return r
+
+    def ping(self) -> dict:
+        return self._request("GET", "/api/v1/ping").json()
+
+    def get_queue(self) -> dict:
+        return self._request("GET", "/api/v1/queue").json()
+
+    def ack(self, submission_id: int) -> None:
+        self._request("POST", f"/api/v1/queue/{submission_id}/ack")
+
+    def nack(self, submission_id: int, reason: str) -> None:
+        self._request("POST", f"/api/v1/queue/{submission_id}/nack", json={"reason": reason})
+
+    def telemetry(self, plugin_version: str = None, fpp_version: str = None) -> None:
+        body = {}
+        if plugin_version is not None:
+            body["plugin_version"] = plugin_version
+        if fpp_version is not None:
+            body["fpp_version"] = fpp_version
+        if not body:
+            return
+        try:
+            self._request("POST", "/api/v1/telemetry", json=body)
+        except (CloudApiError, LicenseExpired, InvalidToken) as exc:
+            # Telemetry is best-effort — never let it break the main loop.
+            log.debug("telemetry report failed (non-fatal): %s", exc)
+
+    def fetch_photo(self, photo_url: str) -> bytes:
+        try:
+            with self._session.get(photo_url, timeout=self.timeout, stream=True) as r:
+                r.raise_for_status()
+                if int(r.headers.get("Content-Length", "0")) > 2_000_000:
+                    raise CloudApiError("Cloud photo is larger than 2 MB")
+                chunks = []
+                total = 0
+                for chunk in r.iter_content(65536):
+                    total += len(chunk)
+                    if total > 2_000_000:
+                        raise CloudApiError("Cloud photo exceeds 2 MB")
+                    chunks.append(chunk)
+                return b"".join(chunks)
+        except requests.RequestException as exc:
+            raise CloudApiError(f"fetch_photo {photo_url} failed: {exc}") from exc
diff --git a/daemon/config.py b/daemon/config.py
new file mode 100644
index 0000000..6fbb68f
--- /dev/null
+++ b/daemon/config.py
@@ -0,0 +1,242 @@
+"""Reads/writes this plugin's settings, status and local-queue files.
+
+All files are plain JSON under <plugin_dir>/config/, shared between the
+Python daemon (this module) and the PHP UI pages (lib/config.php). Keeping
+the format dead simple (no dependency on FPP's PHP settings helpers) means
+either side can read/write it without the other.
+
+IMPORTANT: this module must stay stdlib-only. scripts/tot_display_image.py
+imports it under FPP's bare system python3 (no venv, no Pillow/requests).
+"""
+
+import fcntl
+import json
+import os
+from dataclasses import asdict, dataclass, field
+
+PLUGIN_DIR = os.path.normpath(os.path.join(os.path.dirname(__file__), ".."))
+CONFIG_DIR = os.path.join(PLUGIN_DIR, "config")
+SETTINGS_PATH = os.path.join(CONFIG_DIR, "settings.json")
+STATUS_PATH = os.path.join(CONFIG_DIR, "status.json")
+LOCAL_QUEUE_PATH = os.path.join(CONFIG_DIR, "local_queue.json")
+LOCAL_QUEUE_LOCK = os.path.join(CONFIG_DIR, "local_queue.lock")
+UPLOADS_DIR = os.path.join(CONFIG_DIR, "uploads")
+
+# Optional cloud service, two named environments (same /api/v1 protocol as
+# the NaughtyNice Cloud plugin this was forked from). Both default to blank:
+# the plugin works fully offline via the local queue (door.php / the "Test
+# fire" button) and only polls a cloud service once a URL + token are set.
+ENVIRONMENTS = ("prod", "dev")
+
+ENVIRONMENT_DEFAULTS = {
+    "prod": {"cloud_base_url": "", "token": ""},
+    "dev": {"cloud_base_url": "", "token": ""},
+}
+
+SCALAR_DEFAULTS = {
+    "environment": "prod",
+    "fpp_base_url": "http://localhost",
+    "poll_interval_seconds": 10,
+    "local_poll_seconds": 2,
+    "playlist": "spooky_news",
+    "ticker_model": "TickerZone",
+    "photo_model": "PhotoZone",
+    "matrix_width": 192,
+    "matrix_height": 192,
+    "photo_zone_height": 140,
+    "ticker_zone_height": 52,
+    "display_duration_seconds": 20,
+    "local_show_photo": True,
+    "header_text": "SPOOKY NEWS",
+    "cloud_enabled": True,
+    "enabled": True,
+}
+
+
+def _default_environments() -> dict:
+    return {name: dict(vals) for name, vals in ENVIRONMENT_DEFAULTS.items()}
+
+
+@dataclass
+class Settings:
+    environment: str = "prod"
+    environments: dict = field(default_factory=_default_environments)
+    fpp_base_url: str = "http://localhost"
+    poll_interval_seconds: int = 10
+    local_poll_seconds: int = 2
+    playlist: str = "spooky_news"
+    ticker_model: str = "TickerZone"
+    photo_model: str = "PhotoZone"
+    matrix_width: int = 192
+    matrix_height: int = 192
+    photo_zone_height: int = 140
+    ticker_zone_height: int = 52
+    display_duration_seconds: int = 20
+    local_show_photo: bool = True
+    header_text: str = "SPOOKY NEWS"
+    cloud_enabled: bool = True
+    enabled: bool = True
+
+    @property
+    def cloud_base_url(self) -> str:
+        return self.environments.get(self.environment, {}).get("cloud_base_url", "")
+
+    @property
+    def token(self) -> str:
+        return self.environments.get(self.environment, {}).get("token", "")
+
+    @property
+    def cloud_configured(self) -> bool:
+        return bool(self.cloud_enabled and self.token and self.cloud_base_url)
+
+
+def load_settings() -> Settings:
+    data = dict(SCALAR_DEFAULTS)
+    data["environments"] = _default_environments()
+
+    raw = {}
+    if os.path.exists(SETTINGS_PATH):
+        try:
+            with open(SETTINGS_PATH) as f:
+                raw = json.load(f)
+        except (json.JSONDecodeError, OSError):
+            raw = {}  # fall back to defaults rather than crash the daemon
+
+    if not isinstance(raw, dict):
+        raw = {}
+
+    for key in SCALAR_DEFAULTS:
+        if key in raw:
+            data[key] = raw[key]
+
+    raw_envs = raw.get("environments")
+    if isinstance(raw_envs, dict):
+        for name in ENVIRONMENTS:
+            env_raw = raw_envs.get(name)
+            if isinstance(env_raw, dict):
+                data["environments"][name].update(
+                    {k: v for k, v in env_raw.items() if k in ("cloud_base_url", "token")}
+                )
+
+    if data["environment"] not in ENVIRONMENTS:
+        data["environment"] = "prod"
+
+    return Settings(**data)
+
+
+def save_settings(settings: Settings) -> None:
+    os.makedirs(CONFIG_DIR, exist_ok=True)
+    tmp = SETTINGS_PATH + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(asdict(settings), f, indent=2)
+    os.replace(tmp, SETTINGS_PATH)
+
+
+def write_status(**kwargs) -> None:
+    os.makedirs(CONFIG_DIR, exist_ok=True)
+    status = read_status()
+    status.update(kwargs)
+    tmp_path = STATUS_PATH + ".tmp"
+    with open(tmp_path, "w") as f:
+        json.dump(status, f, indent=2)
+    os.replace(tmp_path, STATUS_PATH)  # atomic, so the PHP pages never read a half-written file
+
+
+def read_status() -> dict:
+    if os.path.exists(STATUS_PATH):
+        try:
+            with open(STATUS_PATH) as f:
+                return json.load(f)
+        except (json.JSONDecodeError, OSError):
+            pass
+    return {}
+
+
+# --- Local queue -----------------------------------------------------------
+# config/local_queue.json is a JSON list of pending items, appended to by
+# the PHP pages (door.php, content.php "Test fire") and consumed here. Both
+# sides take an exclusive flock() on config/local_queue.lock around every
+# read-modify-write; PHP's flock() and Python's fcntl.flock() are the same
+# syscall on Linux, so they genuinely exclude each other.
+
+class _QueueLock:
+    def __enter__(self):
+        os.makedirs(CONFIG_DIR, exist_ok=True)
+        self._fh = open(LOCAL_QUEUE_LOCK, "a+")
+        fcntl.flock(self._fh, fcntl.LOCK_EX)
+        return self
+
+    def __exit__(self, *exc):
+        fcntl.flock(self._fh, fcntl.LOCK_UN)
+        self._fh.close()
+
+
+def _read_queue_unlocked() -> list:
+    if not os.path.exists(LOCAL_QUEUE_PATH):
+        return []
+    try:
+        with open(LOCAL_QUEUE_PATH) as f:
+            data = json.load(f)
+        return data if isinstance(data, list) else []
+    except (json.JSONDecodeError, OSError):
+        return []
+
+
+def _write_queue_unlocked(items: list) -> None:
+    tmp = LOCAL_QUEUE_PATH + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(items, f, indent=2)
+    os.replace(tmp, LOCAL_QUEUE_PATH)
+
+
+def peek_local_queue() -> dict:
+    """Oldest pending local item, or None. Left in the queue until
+    finish_local_item() is called, so a crash mid-display doesn't lose it."""
+    with _QueueLock():
+        items = _read_queue_unlocked()
+        return items[0] if items else None
+
+
+def local_queue_length() -> int:
+    with _QueueLock():
+        return len(_read_queue_unlocked())
+
+
+def finish_local_item(item_id: str, ok: bool, max_attempts: int = 3) -> None:
+    """Remove the item on success; on failure bump its attempt count and
+    drop it after max_attempts (mirrors the cloud's 3-nack expiry)."""
+    with _QueueLock():
+        items = _read_queue_unlocked()
+        keep = []
+        for it in items:
+            if it.get("id") != item_id:
+                keep.append(it)
+                continue
+            if ok:
+                _delete_upload(it)
+                continue
+            it["attempts"] = int(it.get("attempts", 0)) + 1
+            if it["attempts"] < max_attempts:
+                keep.append(it)
+            else:
+                _delete_upload(it)
+        _write_queue_unlocked(keep)
+
+
+def _delete_upload(item: dict) -> None:
+    path = local_photo_path(item)
+    if path:
+        try:
+            os.remove(path)
+        except OSError:
+            pass
+
+
+def local_photo_path(item: dict):
+    """Resolve an item's uploaded photo to a path INSIDE UPLOADS_DIR only
+    (the filename comes from a web form, so never trust it as a path)."""
+    name = item.get("photo_file")
+    if not name:
+        return None
+    path = os.path.join(UPLOADS_DIR, os.path.basename(str(name)))
+    return path if os.path.isfile(path) else None
diff --git a/daemon/fpp_client.py b/daemon/fpp_client.py
new file mode 100644
index 0000000..0ffecc5
--- /dev/null
+++ b/daemon/fpp_client.py
@@ -0,0 +1,303 @@
+"""
+FPP REST API client — FPP 9.x compatible.
+
+Forked from fpp-plugin-naughtynice's fpp_client.py. All of the FPP 9.x
+plumbing (and the hard-won quirk handling below) is unchanged; only the
+artwork and wording are Halloween-themed.
+
+FPP API docs: http://<fpp-host>/api/help
+
+Notable FPP 9.x quirks (carried over from the NaughtyNice plugin):
+- Playlist start: GET /api/playlist/{name}/start  (singular; /api/playlists/ is list-only)
+- Command API: args must be an ARRAY, not a dict
+- Photo display: composite onto background, upload raw PNG bytes via
+  POST /api/file/images/{filename} (NOT /jqUpload) -> script playlist entry
+- Ticker text: "Text" effect (not "Scrolling Text"); array arg order matters
+"""
+
+import io
+import logging
+import os
+import time
+from typing import Optional
+
+import requests
+from PIL import Image, ImageDraw, ImageFont
+
+from halloween_art import slime_drips
+
+log = logging.getLogger(__name__)
+
+# Distinct from the NaughtyNice plugin's current_display.png so both
+# plugins can be installed side by side without clobbering each other.
+_DISPLAY_FILENAME = "tot_current_display.png"
+
+# Overlay dimensions (PhotoZone is 192x140 by default — configurable via
+# settings.json for other matrix layouts)
+_HEADER_H = 20
+_LOWER_H = 22
+
+_COLOR_BLACK = (0, 0, 0)
+_COLOR_HEADER_BG = (12, 0, 20)
+_COLOR_ORANGE = (255, 120, 0)
+_COLOR_SLIME = (110, 230, 40)
+_COLOR_PURPLE = (70, 10, 110)
+_COLOR_WHITE = (255, 255, 255)
+
+TREAT = "treat"
+TRICK = "trick"
+
+_TICKER_COLORS = {TREAT: "#FF7800", TRICK: "#6EE628"}
+
+_TICKER_TEMPLATES = {
+    TREAT: (
+        "SPOOKY NEWS: {who} gets a TREAT from the Great Pumpkin!",
+        "{who} is on the TREAT list - the ghosts approve!",
+        "BREAKING BOOS: {who} has earned a full bag of TREATS!",
+        "The witches have spoken: {who} gets a TREAT tonight!",
+    ),
+    TRICK: (
+        "SPOOKY NEWS: {who} is on the TRICK list... the ghosts are watching!",
+        "BEWARE: {who} has been marked for a TRICK!",
+        "BREAKING BOOS: the witches have a TRICK planned for {who}!",
+        "Uh oh... the skeletons voted {who} for a TRICK!",
+    ),
+}
+
+
+def normalize_verdict(verdict) -> str:
+    """'treat'/'trick', also accepting NaughtyNice's 'nice'/'naughty' so a
+    cloud service speaking the original protocol still works."""
+    v = str(verdict or "").strip().lower()
+    if v in (TRICK, "naughty"):
+        return TRICK
+    return TREAT
+
+
+def display_name(child_name: str, costume: Optional[str]) -> str:
+    """'Emma' or 'Emma the Witch' when a costume was given."""
+    name = (child_name or "").strip() or "A mystery guest"
+    c = (costume or "").strip()
+    if c and c.lower() not in ("boy", "girl"):
+        c = c[:24]
+        if not c.lower().startswith(("the ", "a ", "an ")):
+            c = "the " + c
+        return f"{name} {c}"
+    return name
+
+
+def _get_font(size: int, bold: bool = False) -> ImageFont.FreeTypeFont:
+    name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
+    for base in ("/usr/share/fonts/truetype/dejavu", "/usr/share/fonts/dejavu", "/usr/share/fonts/TTF"):
+        path = os.path.join(base, name)
+        if os.path.exists(path):
+            try:
+                return ImageFont.truetype(path, size)
+            except Exception:
+                pass
+    return ImageFont.load_default()
+
+
+def _draw_text_centered(draw, text, font, x0, y0, x1, y1, color) -> None:
+    bb = font.getbbox(text)
+    tw, th = bb[2] - bb[0], bb[3] - bb[1]
+    x = x0 + ((x1 - x0) - tw) // 2
+    y = y0 + ((y1 - y0) - th) // 2
+    draw.text((x, y), text, fill=color, font=font)
+
+
+class FPPClient:
+    def __init__(self, base_url: str, ticker_model: str, playlist: str,
+                 matrix_width: int = 192, photo_zone_height: int = 140,
+                 timeout: int = 5):
+        self.base_url = base_url.rstrip("/")
+        self.ticker_model = ticker_model
+        self.playlist = playlist
+        self.matrix_width = matrix_width
+        self.photo_zone_height = photo_zone_height
+        self.timeout = timeout
+
+    def is_alive(self) -> bool:
+        return self._fetch_status() is not None
+
+    def get_fpp_version(self) -> Optional[str]:
+        """GET /api/fppd/version -> {"version": "9.5.3-5-g87310ad7a", ...}.
+        Used purely for telemetry (handy when troubleshooting) -- never fatal if it
+        fails, just omitted from that poll's telemetry report."""
+        try:
+            r = requests.get(f"{self.base_url}/api/fppd/version", timeout=self.timeout)
+            if r.status_code == 200:
+                version = r.json().get("version")
+                return version or None
+            log.warning("FPP version check -> HTTP %s", r.status_code)
+            return None
+        except (requests.RequestException, ValueError) as exc:
+            log.warning("FPP version check failed: %s", exc)
+            return None
+
+    def _fetch_status(self) -> Optional[dict]:
+        """GET /api/system/status — NOT /api/status, which 404s on FPP 9.x
+        (confirmed against a live 9.5.3 box; that older path is a Limonade
+        route that no longer exists). Shared by is_alive() and
+        break_in_and_sync()'s polling loop."""
+        try:
+            r = requests.get(f"{self.base_url}/api/system/status", timeout=self.timeout)
+            if r.status_code == 200:
+                return r.json()
+            log.warning("FPP status check -> HTTP %s", r.status_code)
+            return None
+        except (requests.RequestException, ValueError) as exc:
+            log.warning("FPP status check failed: %s", exc)
+            return None
+
+    def break_in_playlist(self, name: Optional[str] = None) -> bool:
+        """GET /api/playlist/{name}/start — SINGULAR. Breaks in from whatever
+        is currently playing; FPP resumes normal sync when it ends."""
+        target = name or self.playlist
+        url = f"{self.base_url}/api/playlist/{target}/start"
+        try:
+            r = requests.get(url, timeout=self.timeout)
+            if r.status_code == 200:
+                log.info("Started FPP playlist: %s", target)
+                return True
+            log.error("break_in_playlist %s -> HTTP %s: %s", target, r.status_code, r.text[:200])
+            return False
+        except requests.RequestException as exc:
+            log.error("break_in_playlist exception: %s", exc)
+            return False
+
+    def break_in_and_sync(self, name: Optional[str] = None, timeout: float = 5.0,
+                           poll_interval: float = 0.25) -> bool:
+        """Break into `name` (or self.playlist) and block until FPP confirms
+        the playlist is actually the active one before returning.
+
+        Why this exists: break_in_playlist() only confirms fppd *accepted*
+        the start command over HTTP -- it does not mean the matrix is
+        actually outputting that content yet. fppd needs a beat to stop
+        whatever was running and load the new playlist/media, and that gap
+        was measurably a couple of seconds on the real Pi 5. Meanwhile
+        push_ticker_text() is an "Overlay Model Effect" command applied on
+        a separate render path (TickerZone), which takes effect essentially
+        immediately. Calling the two back-to-back without this wait meant
+        the ticker text started scrolling visibly before the photo/
+        background playlist appeared -- reported in the original plugin as "text scrolling
+        started before the rest of the screen rendered by a few seconds."
+
+        Polls GET /api/system/status (see _fetch_status) and watches its
+        "playlist" field for the target name -- confirmed via a live status
+        dump that this field is empty when no playlist is the active
+        selection and becomes the playlist's name once fppd has actually
+        switched to it. If FPP never reports the switch within `timeout`,
+        logs a warning and returns True anyway (the break-in call itself
+        succeeded, so we don't want a flaky status poll to nack an
+        otherwise-working submission) -- worst case, sync degrades back to
+        the old race instead of the item failing outright.
+        """
+        target = name or self.playlist
+        if not self.break_in_playlist(target):
+            return False
+
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            status = self._fetch_status()
+            if status is not None and status.get("playlist") == target:
+                log.info("Confirmed FPP switched to playlist %s before signaling ticker", target)
+                return True
+            time.sleep(poll_interval)
+
+        log.warning(
+            "break_in_and_sync: FPP never reported playlist=%s as active within %.1fs -- "
+            "proceeding anyway, ticker text may start slightly ahead of the visual",
+            target, timeout,
+        )
+        return True
+
+    def push_photo_overlay(self, photo: Image.Image, child_name: str, verdict: str,
+                           header_text: str = "SPOOKY NEWS") -> bool:
+        """Composite photo onto a matrix_width x matrix_width canvas with the
+        Halloween news overlay, upload as tot_current_display.png."""
+        verdict = normalize_verdict(verdict)
+        w = self.matrix_width
+        lower_y = self.photo_zone_height - _LOWER_H if self.photo_zone_height >= _LOWER_H else 0
+        badge_x = int(w * 0.635)
+
+        try:
+            canvas = Image.new("RGBA", (w, self.photo_zone_height), (0, 0, 0, 255))
+            canvas.alpha_composite(photo.convert("RGBA"), (0, 0))
+            canvas = canvas.convert("RGB")
+            draw = ImageDraw.Draw(canvas)
+
+            # Header: near-black bar, orange title, slime dripping off the bottom
+            draw.rectangle([(0, 0), (w - 1, _HEADER_H - 1)], fill=_COLOR_HEADER_BG)
+            draw.line([(0, _HEADER_H - 2), (w - 1, _HEADER_H - 2)], fill=_COLOR_SLIME, width=2)
+            slime_drips(draw, 0, w, _HEADER_H - 1, _COLOR_SLIME, seed=child_name or "boo")
+            font_header = _get_font(11, bold=True)
+            title = (header_text or "SPOOKY NEWS").upper()[:24]
+            _draw_text_centered(draw, title, font_header, 0, 0, w - 1, _HEADER_H - 2, _COLOR_ORANGE)
+
+            # Lower third: purple name bar + TREAT (orange) / TRICK (slime) badge
+            draw.rectangle([(0, lower_y), (w - 1, lower_y + _LOWER_H - 1)], fill=_COLOR_PURPLE)
+            badge_color = _COLOR_ORANGE if verdict == TREAT else _COLOR_SLIME
+            draw.rectangle([(badge_x, lower_y), (w - 1, lower_y + _LOWER_H - 1)], fill=badge_color)
+            draw.line([(0, lower_y), (w - 1, lower_y)], fill=_COLOR_ORANGE, width=1)
+
+            font_name = _get_font(10)
+            font_status = _get_font(11, bold=True)
+
+            import re
+            name_display = re.sub(r"<[^>]*>", "", (child_name or ""))
+            name_display = re.sub(r"[<>\x00-\x1f\x7f]", "", name_display).upper()
+            while font_name.getbbox(name_display)[2] > (badge_x - 8) and len(name_display) > 1:
+                name_display = name_display[:-1]
+            draw.text((4, lower_y + 5), name_display, fill=_COLOR_WHITE, font=font_name)
+
+            status_text = "TREAT!" if verdict == TREAT else "TRICK!"
+            _draw_text_centered(draw, status_text, font_status, badge_x, lower_y, w - 1, lower_y + _LOWER_H, _COLOR_BLACK)
+
+            buf = io.BytesIO()
+            canvas.save(buf, format="PNG")
+            buf.seek(0)
+        except Exception as exc:
+            log.error("push_photo_overlay image processing error: %s", exc)
+            return False
+
+        url = f"{self.base_url}/api/file/images/{_DISPLAY_FILENAME}"
+        try:
+            r = requests.post(url, data=buf.read(), headers={"Content-Type": "image/png"}, timeout=max(self.timeout, 15))
+            if r.status_code in (200, 204):
+                log.info("Uploaded %s to FPP", _DISPLAY_FILENAME)
+                return True
+            log.error("push_photo_overlay upload -> HTTP %s: %s", r.status_code, r.text[:200])
+            return False
+        except requests.RequestException as exc:
+            log.error("push_photo_overlay upload exception: %s", exc)
+            return False
+
+    def push_ticker_text(self, child_name: str, verdict: str, costume: Optional[str] = None) -> bool:
+        """FPP 9.x command API: args MUST be an array, not a dict."""
+        verdict = normalize_verdict(verdict)
+        color = _TICKER_COLORS[verdict]
+        # Visitors always receive the same friendly personalized greeting.
+        # Costume remains available for artwork selection and photo composition.
+        import re
+        safe_name = re.sub(r"<[^>]*>", "", " ".join(str(child_name or "").split()))
+        safe_name = re.sub(r"[<>\x00-\x1f\x7f]", "", safe_name)[:40] or "FRIEND"
+        message = f"  WELCOME {safe_name.upper()}! HAPPY HALLOWEEN!  "
+
+        payload = {
+            "command": "Overlay Model Effect",
+            "args": [
+                self.ticker_model, "Enabled", "Text", color,
+                "DejaVuSans", "16", "false", "Right to Left", "30", "0", message,
+            ],
+        }
+        try:
+            r = requests.post(f"{self.base_url}/api/command", json=payload, timeout=self.timeout)
+            if r.status_code in (200, 204):
+                log.info("Ticker text pushed: %s", message.strip())
+                return True
+            log.error("push_ticker_text -> HTTP %s: %s", r.status_code, r.text[:200])
+            return False
+        except requests.RequestException as exc:
+            log.error("push_ticker_text exception: %s", exc)
+            return False
